<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Framework handshake for Scalable UI SafeBounds / remote insets (Android 17).
      Does NOT zero status/nav bar heights — CarSystemUI bars stay real.
      See https://source.android.com/docs/automotive/scalableui

      Android 17 Advanced Windowing removes legacy developer overrides that
      restricted app resizing and orientations. TaskPanel hosts should declare
      resizeableActivity=true and configChanges so WM delivers continuous
      onConfigurationChanged during zero-stutter split resize.
    -->
    <bool name="config_remoteInsetsControllerControlsSystemBars">true</bool>
</resources>
