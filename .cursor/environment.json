{
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "install": "chmod +x ./gradlew .cursor/scripts/*.sh scripts/cuttlefish/*.sh docker/cuttlefish/entrypoint.sh && .cursor/scripts/cloud-install.sh",
  "start": "export ANDROID_HOME=/opt/android-sdk JAVA_HOME=/usr/lib/jvm/java-17-openjdk-amd64 PATH=$PATH:/opt/android-sdk/cmdline-tools/latest/bin:/opt/android-sdk/platform-tools:/opt/android-sdk/emulator",
  "terminals": [
    {
      "name": "aaos-device",
      "command": ".cursor/scripts/start-device.sh"
    }
  ]
}
