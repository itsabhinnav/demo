<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      Production Adaptive Space Scalable UI RRO (Android 17 Advanced Windowing):
        Map-Under-Apps + dynamic media/parking overlays + zero-stutter split resize.

      No resourcesMap — overlay replaces resources by name when the target
      CarSystemUI already declares them (or after CARSYSTEMUI.md changes land).
    -->
    <overlay
        android:targetPackage="com.android.systemui"
        android:priority="900"
        android:isStatic="false" />

    <application
        android:hasCode="false"
        android:label="Design Adaptive Space Scalable UI RRO" />
</manifest>
