<?xml version="1.0" encoding="utf-8"?>
<!--
  Floating top SystemBar (Scalable UI), not legacy TopCarSystemBar / CarSystemBarPanel.
  Touches the top edge (required); side insets + Corner give the floating glass look.
  Literal dp for insets/radius so idmap works on products that lack Design-only dimens.
  View/layout chrome is provided by CarSystemUI (see CARSYSTEMUI.md).
-->
<SystemBar
    id="status"
    type="status"
    barZOrder="200"
    hideForKeyboard="false"
    dragOpenNotification="true"
    defaultVariant="@id/open">

    <Variant id="@+id/base">
        <Bounds
            left="0"
            leftOffset="12dp"
            top="0dp"
            right="100%"
            rightOffset="12dp"
            height="@dimen/status_bar_height" />
        <Corner radius="28dp" />
        <Alpha alpha="1.0" />
        <!-- Insets match floating chrome so SafeBounds / remote insets clear the glass bar -->
        <Insets left="12dp" top="@dimen/status_bar_height" right="12dp" bottom="0dp" />
    </Variant>

    <Variant id="@+id/open" parent="@id/base">
        <Visibility isVisible="true" />
    </Variant>

    <Variant id="@+id/closed" parent="@id/base">
        <Visibility isVisible="false" />
        <Alpha alpha="0.0" />
    </Variant>

    <Transitions>
        <Transition
            onEvent="_System_Show_Panel"
            onEventTokens="panelId=status"
            toVariant="@id/open"
            duration="@integer/panel_transition_ms" />
        <Transition
            onEvent="_System_Hide_Panel"
            onEventTokens="panelId=status"
            toVariant="@id/closed"
            duration="@integer/panel_transition_ms" />
        <Transition
            onEvent="_System_OnHomeEvent"
            toVariant="@id/open"
            duration="@integer/home_restore_transition_ms" />
    </Transitions>
</SystemBar>
