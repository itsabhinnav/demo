<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive Space Scalable UI actions — bind OEM / system events to intents.
  Wire selectedEvent / unselectedEvent on CarSystemBarButton to the same event ids.
-->
<Actions>
    <Action intent="@string/default_map_intent">
        <Event id="_System_TaskOpenEvent" panelId="map_panel" />
    </Action>
    <Action intent="intent:#Intent;action=android.intent.action.MAIN;component=com.test.design/.presentation.ivi.glanceables.MediaOverlayActivity;end">
        <Event id="_Design_OpenMediaOverlay" />
    </Action>
    <Action intent="intent:#Intent;action=android.intent.action.MAIN;component=com.test.design/.presentation.ivi.adaptivespace.ParkingAssistantActivity;end">
        <Event id="_Design_OpenParking" />
    </Action>
</Actions>
