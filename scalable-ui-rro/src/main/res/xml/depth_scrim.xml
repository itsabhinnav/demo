<?xml version="1.0" encoding="utf-8"?>
<!--
  DecorPanel Z-depth between map (L2) and floating TaskPanels.
  Softens glass overlays without interrupting map navigation.
-->
<DecorPanel
    id="depth_scrim"
    defaultVariant="@id/idle"
    defaultLayer="@integer/depth_scrim_layer"
    displayId="0">

    <Variant id="@+id/base">
        <Layer layer="@integer/depth_scrim_layer" />
        <Bounds
            left="0"
            top="0"
            right="100%"
            bottom="100%" />
        <Corner radius="@dimen/depth_scrim_corner_radius" />
        <Alpha alpha="0.0" />
    </Variant>

    <Variant id="@+id/idle" parent="@id/base">
        <Visibility isVisible="false" />
        <Alpha alpha="0.0" />
    </Variant>

    <Variant id="@+id/dimmed" parent="@id/base">
        <Visibility isVisible="true" />
        <Alpha alpha="0.28" />
    </Variant>

    <Transitions>
        <Transition
            onEvent="_System_OnHomeEvent"
            toVariant="@id/idle"
            duration="@integer/home_restore_transition_ms" />
        <Transition
            onEvent="@string/event_open_media_overlay"
            toVariant="@id/dimmed"
            duration="@integer/overlay_transition_ms"
            interpolator="@android:anim/decelerate_interpolator" />
        <Transition
            onEvent="@string/event_close_media_overlay"
            toVariant="@id/idle"
            duration="@integer/overlay_transition_ms" />
        <Transition
            onEvent="@string/event_open_parking"
            toVariant="@id/dimmed"
            duration="@integer/overlay_transition_ms"
            interpolator="@android:anim/decelerate_interpolator" />
        <Transition
            onEvent="@string/event_close_parking"
            toVariant="@id/idle"
            duration="@integer/overlay_transition_ms" />
        <Transition
            onEvent="@string/event_split_narrow"
            toVariant="@id/dimmed"
            duration="@integer/split_resize_transition_ms" />
        <Transition
            onEvent="@string/event_split_mid"
            toVariant="@id/dimmed"
            duration="@integer/split_resize_transition_ms" />
        <Transition
            onEvent="@string/event_split_wide"
            toVariant="@id/dimmed"
            duration="@integer/split_resize_transition_ms" />
        <Transition
            onEvent="@string/event_close_split"
            toVariant="@id/idle"
            duration="@integer/split_resize_transition_ms" />
        <Transition
            onEvent="_System_TaskOpenEvent"
            onEventTokens="panelId=app_panel"
            toVariant="@id/dimmed"
            duration="@integer/panel_transition_ms" />
        <Transition
            onEvent="_System_TaskPanelEmptyEvent"
            onEventTokens="panelId=app_panel"
            toVariant="@id/idle"
            duration="@integer/panel_transition_ms" />
    </Transitions>
</DecorPanel>
