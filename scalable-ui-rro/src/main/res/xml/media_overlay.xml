<?xml version="1.0" encoding="utf-8"?>
<!--
  Secondary media controller overlay — slides in from the trailing edge.
  Map navigation under the overlay continues uninterrupted (independent Z-order).
-->
<TaskPanel
    id="media_overlay"
    controller="@xml/media_overlay_controller"
    role="@array/role_media_overlay_components"
    defaultVariant="@id/closed"
    defaultLayer="@integer/media_overlay_layer"
    displayId="0">

    <Restart policy="DEFAULT" maxRetry="2" />
    <TaskBehavior newTaskLaunchPolicy="REMAIN_IN_SOURCE" />

    <Variant id="@+id/base">
        <Layer layer="@integer/media_overlay_layer" />
        <Bounds
            right="100%"
            rightOffset="@dimen/overlay_panel_trailing_inset"
            top="0"
            topOffset="@dimen/status_bar_height"
            width="@dimen/overlay_panel_width"
            bottom="100%"
            bottomOffset="@dimen/navigation_bar_height" />
        <Insets
            left="0"
            top="@dimen/overlay_panel_top_gap"
            right="0"
            bottom="@dimen/overlay_panel_bottom_gap" />
        <Corner radius="@dimen/overlay_panel_corner_radius" />
        <Alpha alpha="1.0" />
        <Focus onTransition="true" />
    </Variant>

    <Variant id="@+id/opened" parent="@id/base">
        <Visibility isVisible="true" />
    </Variant>

    <!-- Off-screen trailing edge — slide closed without destroying the task -->
    <Variant id="@+id/closed" parent="@id/base">
        <Visibility isVisible="false" />
        <Bounds
            left="100%"
            top="0"
            topOffset="@dimen/status_bar_height"
            width="@dimen/overlay_panel_width"
            bottom="100%"
            bottomOffset="@dimen/navigation_bar_height" />
        <Alpha alpha="0.0" />
    </Variant>

    <Transitions>
        <Transition
            onEvent="@string/event_open_media_overlay"
            toVariant="@id/opened"
            duration="@integer/overlay_transition_ms"
            interpolator="@android:anim/decelerate_interpolator" />
        <Transition
            onEvent="@string/event_close_media_overlay"
            toVariant="@id/closed"
            duration="@integer/overlay_transition_ms"
            interpolator="@android:anim/accelerate_interpolator" />
        <Transition
            onEvent="@string/event_toggle_media_overlay"
            fromVariant="@id/closed"
            toVariant="@id/opened"
            duration="@integer/overlay_transition_ms"
            interpolator="@android:anim/decelerate_interpolator" />
        <Transition
            onEvent="@string/event_toggle_media_overlay"
            fromVariant="@id/opened"
            toVariant="@id/closed"
            duration="@integer/overlay_transition_ms"
            interpolator="@android:anim/accelerate_interpolator" />
        <Transition
            onEvent="_System_OnHomeEvent"
            toVariant="@id/closed"
            duration="@integer/home_restore_transition_ms" />
        <Transition
            onEvent="_System_TaskOpenEvent"
            onEventTokens="panelId=app_panel"
            toVariant="@id/closed"
            duration="@integer/panel_transition_ms" />
        <Transition
            onEvent="@string/event_open_parking"
            toVariant="@id/closed"
            duration="@integer/overlay_transition_ms" />
    </Transitions>
</TaskPanel>
