<?xml version="1.0" encoding="utf-8"?>
<!--
  Transient / split-screen app surface above map.
  Narrow → mid → wide → full variants showcase zero-stutter resize:
  WM animates bounds; hosted activities handle config via onConfigurationChanged
  (resizeableActivity + configChanges) without restart.
-->
<TaskPanel
    id="app_panel"
    defaultVariant="@id/closed"
    defaultLayer="@integer/app_panel_layer"
    displayId="0">

    <Restart policy="DEFAULT" maxRetry="1" />
    <TaskBehavior newTaskLaunchPolicy="DEFAULT" />

    <Variant id="@+id/base">
        <Layer layer="@integer/app_panel_layer" />
        <Bounds
            left="@dimen/split_app_leading_inset"
            top="0"
            topOffset="@dimen/status_bar_height"
            right="100%"
            rightOffset="@dimen/overlay_panel_trailing_inset"
            bottom="100%"
            bottomOffset="@dimen/navigation_bar_height" />
        <Corner radius="@dimen/app_panel_corner_radius" />
        <Alpha alpha="1.0" />
        <Focus onTransition="true" />
    </Variant>

    <!-- Full app (default open) -->
    <Variant id="@+id/opened" parent="@id/base">
        <Visibility isVisible="true" />
    </Variant>

    <!-- Split lanes — map remains visible in the trailing remainder -->
    <Variant id="@+id/split_narrow" parent="@id/base">
        <Visibility isVisible="true" />
        <Bounds
            left="@dimen/split_app_leading_inset"
            top="0"
            topOffset="@dimen/status_bar_height"
            width="40%"
            bottom="100%"
            bottomOffset="@dimen/navigation_bar_height" />
    </Variant>

    <Variant id="@+id/split_mid" parent="@id/base">
        <Visibility isVisible="true" />
        <Bounds
            left="@dimen/split_app_leading_inset"
            top="0"
            topOffset="@dimen/status_bar_height"
            width="55%"
            bottom="100%"
            bottomOffset="@dimen/navigation_bar_height" />
    </Variant>

    <Variant id="@+id/split_wide" parent="@id/base">
        <Visibility isVisible="true" />
        <Bounds
            left="@dimen/split_app_leading_inset"
            top="0"
            topOffset="@dimen/status_bar_height"
            width="70%"
            bottom="100%"
            bottomOffset="@dimen/navigation_bar_height" />
    </Variant>

    <!-- Continuous drag resize between narrow and wide (fraction 0→1) -->
    <DynamicVariant
        id="@+id/split_resizing"
        fromVariant="@id/split_narrow"
        toVariant="@id/split_wide" />

    <Variant id="@+id/closed" parent="@id/base">
        <Visibility isVisible="false" />
        <Bounds
            left="100%"
            top="0"
            width="0"
            height="0" />
        <Alpha alpha="0.0" />
    </Variant>

    <Transitions>
        <Transition
            onEvent="_System_TaskOpenEvent"
            onEventTokens="panelId=app_panel"
            toVariant="@id/opened"
            duration="@integer/panel_transition_ms"
            interpolator="@android:anim/decelerate_interpolator" />
        <Transition
            onEvent="_System_TaskPanelEmptyEvent"
            onEventTokens="panelId=app_panel"
            toVariant="@id/closed"
            duration="@integer/panel_transition_ms"
            interpolator="@android:anim/accelerate_interpolator" />
        <Transition
            onEvent="_System_OnHomeEvent"
            toVariant="@id/closed"
            duration="@integer/home_restore_transition_ms"
            interpolator="@android:anim/accelerate_interpolator" />
        <Transition
            onEvent="@string/event_split_narrow"
            toVariant="@id/split_narrow"
            duration="@integer/split_resize_transition_ms"
            interpolator="@android:anim/accelerate_decelerate_interpolator" />
        <Transition
            onEvent="@string/event_split_mid"
            toVariant="@id/split_mid"
            duration="@integer/split_resize_transition_ms"
            interpolator="@android:anim/accelerate_decelerate_interpolator" />
        <Transition
            onEvent="@string/event_split_wide"
            toVariant="@id/split_wide"
            duration="@integer/split_resize_transition_ms"
            interpolator="@android:anim/accelerate_decelerate_interpolator" />
        <Transition
            onEvent="@string/event_split_full"
            toVariant="@id/opened"
            duration="@integer/split_resize_transition_ms"
            interpolator="@android:anim/accelerate_decelerate_interpolator" />
        <Transition
            onEvent="@string/event_close_split"
            toVariant="@id/closed"
            duration="@integer/split_resize_transition_ms"
            interpolator="@android:anim/accelerate_interpolator" />
    </Transitions>
</TaskPanel>
