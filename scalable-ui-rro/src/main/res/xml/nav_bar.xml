<?xml version="1.0" encoding="utf-8"?>
<!--
  Floating bottom SystemBar (Scalable UI), not legacy BottomCarSystemBar / CarSystemBarPanel.
  Touches the bottom edge (required); side insets + Corner give the floating glass look.
  Literal dp for insets/radius so idmap works on products that lack Design-only dimens.
  HVAC / dock layout is CarSystemUI work (see CARSYSTEMUI.md).
-->
<SystemBar
    id="nav"
    type="navigation"
    barZOrder="210"
    hideForKeyboard="true"
    defaultVariant="@id/open">

    <Variant id="@+id/base">
        <Bounds
            left="0"
            leftOffset="12dp"
            bottom="100%"
            bottomOffset="0dp"
            right="100%"
            rightOffset="12dp"
            height="@dimen/navigation_bar_height" />
        <Corner radius="28dp" />
        <Alpha alpha="1.0" />
        <Insets left="12dp" top="0dp" right="12dp" bottom="@dimen/navigation_bar_height" />
    </Variant>

    <Variant id="@+id/open" parent="@id/base">
        <Visibility isVisible="true" />
    </Variant>

    <Variant id="@+id/closed" parent="@id/base">
        <Visibility isVisible="false" />
        <Alpha alpha="0.0" />
    </Variant>

    <Transitions>
        <Transition
            onEvent="_System_Show_Panel"
            onEventTokens="panelId=nav"
            toVariant="@id/open"
            duration="@integer/panel_transition_ms" />
        <Transition
            onEvent="_System_Hide_Panel"
            onEventTokens="panelId=nav"
            toVariant="@id/closed"
            duration="@integer/panel_transition_ms" />
        <Transition
            onEvent="_System_OnHomeEvent"
            toVariant="@id/open"
            duration="@integer/home_restore_transition_ms" />
    </Transitions>
</SystemBar>
