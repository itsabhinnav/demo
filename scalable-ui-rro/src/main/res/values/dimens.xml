<?xml version="1.0" encoding="utf-8"?>
<!--
  Tangorpro-class landscape (~2560x1600 @ 220dpi ≈ 1862x1164 dp).
  Matches Design Compose floating chrome (FloatingSystemBars / DrivingRail).
-->
<resources>
    <!-- Canvas -->
    <dimen name="screen_width">1862dp</dimen>
    <dimen name="screen_height">1164dp</dimen>

    <!-- Floating SystemBars (Scalable UI <SystemBar>, not legacy CarSystemBarPanel) -->
    <dimen name="status_bar_height">64dp</dimen>
    <dimen name="navigation_bar_height">84dp</dimen>
    <dimen name="system_bar_edge_inset">0dp</dimen>
    <dimen name="system_bar_side_inset">12dp</dimen>
    <dimen name="system_bar_corner_radius">28dp</dimen>

    <!-- Floating left widget rail -->
    <dimen name="widget_panel_width">420dp</dimen>
    <dimen name="widget_panel_left_inset">12dp</dimen>
    <dimen name="widget_panel_top_gap">12dp</dimen>
    <dimen name="widget_panel_bottom_gap">12dp</dimen>
    <dimen name="widget_panel_corner_radius">28dp</dimen>

    <!-- Full-bleed map under everything -->
    <dimen name="map_corner_radius">0dp</dimen>
</resources>
