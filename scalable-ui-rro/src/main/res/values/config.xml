<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 17 Scalable UI / Advanced Windowing -->
    <bool name="config_enableScalableUI" translatable="false">true</bool>

    <!--
      Disable legacy CarSystemBarPanel paths (Top/Bottom/Left/RightCarSystemBar).
      Home chrome must be Scalable UI floating <SystemBar id="status|nav"> panels
      in window_states — side-inset + Corner glass bars, not full-bleed strips.
      See https://source.android.com/docs/automotive/scalableui/system-bars
    -->
    <bool name="config_enableTopSystemBar">false</bool>
    <bool name="config_enableBottomSystemBar">false</bool>
    <bool name="config_enableLeftSystemBar">false</bool>
    <bool name="config_enableRightSystemBar">false</bool>

    <!-- Scalable UI drag discovery (fallback if XML attrs are ignored) -->
    <string-array name="config_notificationDragOpenListener" translatable="false">
        <item>status</item>
    </string-array>

    <!-- Prefer root-task model over legacy split-screen multitasking conflicts -->
    <bool name="config_enableClearBackStack">false</bool>
    <bool name="config_enableSafeAreaAndToolbarPerDisplay">false</bool>

    <string name="config_privacyIndicatorLocation" translatable="false">status</string>

    <!--
      Adaptive Space — Map-Under-Apps home scene (Android 17 Scalable UI)

        map_panel           — closed by default (empty backdrop host only; no OSM)
        depth_scrim         — DecorPanel Z-depth between map and overlays
        widget_panel        — floating left glanceable rail (primary Design home surface)
        media_overlay       — slide-in media controller (independent Z)
        parking_assistant   — slide-in parking overlay
        app_panel           — transient / split-screen apps (zero-stutter resize variants)
        status / nav        — floating Scalable UI SystemBars
    -->
    <array name="window_states">
        <item>@xml/map_panel</item>
        <item>@xml/depth_scrim</item>
        <item>@xml/widget_panel</item>
        <item>@xml/media_overlay</item>
        <item>@xml/parking_assistant</item>
        <item>@xml/app_panel</item>
        <item>@xml/status_bar</item>
        <item>@xml/nav_bar</item>
    </array>

    <!-- Boot hosts: sidebar only — no OSM / MapActivity. -->
    <string-array name="config_default_activities" translatable="false">
        <item>widget_panel;com.test.design/.presentation.ivi.glanceables.DrivingRailActivity</item>
        <item>media_overlay;com.test.design/.presentation.ivi.glanceables.MediaOverlayActivity</item>
        <item>parking_assistant;com.test.design/.presentation.ivi.adaptivespace.ParkingAssistantActivity</item>
    </string-array>
</resources>
