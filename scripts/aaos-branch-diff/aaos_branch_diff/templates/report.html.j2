<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light only">
  <meta name="theme-color" content="#ffffff">
  <title>{{ branch_a }} → {{ branch_b }} · Branch Diff</title>
  <style>
    :root {
      color-scheme: light;
      --bg: #ffffff;
      --bg-subtle: #f6f8fa;
      --card: #ffffff;
      --text: #24292f;
      --muted: #57606a;
      --border: #d8dee4;
      --accent: #0969da;
      --added: #1a7f37;
      --removed: #cf222e;
      --modified: #9a6700;
      --renamed: #8250df;
    }
    html {
      color-scheme: light;
      background: var(--bg-subtle);
    }
    * { box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg-subtle);
      color: var(--text);
      margin: 0;
      line-height: 1.6;
      font-size: 15px;
    }
    .wrap { max-width: 960px; margin: 0 auto; padding: 2rem 1.25rem 3rem; }
    header { margin-bottom: 2rem; }
    h1 { font-size: 1.75rem; font-weight: 600; margin: 0 0 .5rem; }
    .subtitle { color: var(--muted); font-size: .95rem; }
    .subtitle code {
      background: #eaeef2;
      padding: .1rem .35rem;
      border-radius: 4px;
      font-size: .85rem;
    }
    .hero {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
      margin-bottom: 2rem;
    }
    .hero p { margin: 0 0 1rem; font-size: 1.05rem; }
    .stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: .75rem;
    }
    .stat {
      text-align: center;
      padding: .75rem;
      background: var(--bg-subtle);
      border-radius: 8px;
    }
    .stat .n { font-size: 1.5rem; font-weight: 700; display: block; }
    .stat .l { font-size: .75rem; color: var(--muted); text-transform: uppercase; letter-spacing: .03em; }
    .stat.added .n { color: var(--added); }
    .stat.removed .n { color: var(--removed); }
    .stat.modified .n { color: var(--modified); }
    section {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.25rem 1.5rem;
      margin-bottom: 1.25rem;
    }
    h2 {
      font-size: 1.1rem;
      margin: 0 0 1rem;
      padding-bottom: .5rem;
      border-bottom: 1px solid var(--border);
    }
    .tabs { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: 1rem; }
    .tab {
      border: 1px solid var(--border);
      background: #fff;
      padding: .4rem .85rem;
      border-radius: 20px;
      font-size: .85rem;
      cursor: pointer;
      color: var(--text);
    }
    .tab.active { background: var(--accent); color: #fff; border-color: var(--accent); }
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }
    .file-list { list-style: none; margin: 0; padding: 0; }
    .file-item {
      padding: .6rem 0;
      border-bottom: 1px solid var(--border);
    }
    .file-item:last-child { border-bottom: none; }
    .file-path {
      font-family: ui-monospace, Menlo, Consolas, monospace;
      font-size: .82rem;
      word-break: break-all;
    }
    .file-meta { font-size: .8rem; color: var(--muted); margin-top: .2rem; }
    .tag {
      display: inline-block;
      font-size: .7rem;
      font-weight: 600;
      padding: .1rem .45rem;
      border-radius: 4px;
      margin-right: .35rem;
      text-transform: uppercase;
    }
    .tag-added { background: #dafbe1; color: var(--added); }
    .tag-removed { background: #ffebe9; color: var(--removed); }
    .tag-modified { background: #fff8c5; color: var(--modified); }
    .tag-renamed { background: #fbefff; color: var(--renamed); }
    .tag-cat { background: #eaeef2; color: var(--muted); text-transform: none; }
    details { margin-top: .35rem; }
    details summary {
      cursor: pointer;
      font-size: .8rem;
      color: var(--accent);
      user-select: none;
    }
    details ul {
      margin: .35rem 0 0;
      padding-left: 1.25rem;
      font-family: ui-monospace, Menlo, Consolas, monospace;
      font-size: .78rem;
      color: var(--muted);
    }
    .simple-table { width: 100%; border-collapse: collapse; font-size: .9rem; }
    .simple-table th, .simple-table td {
      padding: .5rem .6rem;
      text-align: left;
      border-bottom: 1px solid var(--border);
    }
    .simple-table th { color: var(--muted); font-weight: 600; font-size: .8rem; background: var(--bg-subtle); }
    .simple-table tr:hover td { background: #f6f8fa; }
    .search {
      width: 100%;
      padding: .55rem .75rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: .9rem;
      margin-bottom: 1rem;
      background: #fff;
      color: var(--text);
    }
  .search:focus { outline: 2px solid var(--accent); outline-offset: 0; }
    .empty { color: var(--muted); font-style: italic; font-size: .9rem; }
    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    @media (max-width: 700px) { .two-col { grid-template-columns: 1fr; } }
    .branch-label { font-weight: 600; margin-bottom: .5rem; font-size: .9rem; }
    .branch-a { color: var(--removed); }
    .branch-b { color: var(--added); }
    .warn-box {
      background: #fff8c5;
      border: 1px solid #d4a72c;
      border-radius: 8px;
      padding: .75rem 1rem;
      font-size: .85rem;
      margin-bottom: 1.25rem;
    }
    .warn-box ul { margin: .5rem 0 0; padding-left: 1.25rem; }
    footer { text-align: center; color: var(--muted); font-size: .8rem; margin-top: 2rem; }
    .compare-row { display: flex; justify-content: space-between; padding: .35rem 0; border-bottom: 1px solid var(--border); font-size: .9rem; }
    .compare-row:last-child { border-bottom: none; }
  </style>
</head>
<body>
  <div class="wrap">
    <header>
      <h1>Branch Diff Report</h1>
      <p class="subtitle">
        <code>{{ branch_a }}</code> → <code>{{ branch_b }}</code>
        &nbsp;·&nbsp; {{ repo_path }}
        &nbsp;·&nbsp; {{ generated_at }}
      </p>
    </header>

    <div class="hero">
      <p>
        Comparing <strong>{{ branch_a }}</strong> (baseline) to <strong>{{ branch_b }}</strong>.
        Below is what changed, was added, or removed between the two branches.
      </p>
      <div class="stats">
        <div class="stat">
          <span class="n">{{ summary.files.total_changed }}</span>
          <span class="l">Files changed</span>
        </div>
        <div class="stat added">
          <span class="n">+{{ summary.files.added }}</span>
          <span class="l">Added</span>
        </div>
        <div class="stat removed">
          <span class="n">−{{ summary.files.removed }}</span>
          <span class="l">Removed</span>
        </div>
        <div class="stat modified">
          <span class="n">~{{ summary.files.modified }}</span>
          <span class="l">Modified</span>
        </div>
        <div class="stat">
          <span class="n">{{ summary.methods.only_in_a + summary.methods.only_in_b }}</span>
          <span class="l">Method changes</span>
        </div>
        <div class="stat">
          <span class="n">{{ summary.apis.only_in_a + summary.apis.only_in_b }}</span>
          <span class="l">API changes</span>
        </div>
      </div>
    </div>

    {% if category_rows %}
    <section>
      <h2>Changes by type</h2>
      <table class="simple-table">
        <thead>
          <tr><th>Type</th><th>Added</th><th>Removed</th><th>Modified</th></tr>
        </thead>
        <tbody>
          {% for row in category_rows %}
          <tr>
            <td>{{ row.label }}</td>
            <td>{% if row.added %}+{{ row.added }}{% else %}—{% endif %}</td>
            <td>{% if row.removed %}−{{ row.removed }}{% else %}—{% endif %}</td>
            <td>{% if row.modified %}~{{ row.modified }}{% else %}—{% endif %}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </section>
    {% endif %}

    <section>
      <h2>Files</h2>
      <input class="search" type="text" placeholder="Search file paths…" oninput="filterFiles(this.value)">
      <div class="tabs" id="fileTabs">
        <button class="tab active" data-tab="added">Added ({{ files_by_status.added|length }})</button>
        <button class="tab" data-tab="removed">Removed ({{ files_by_status.removed|length }})</button>
        <button class="tab" data-tab="modified">Modified ({{ files_by_status.modified|length }})</button>
        {% if files_by_status.renamed|length %}
        <button class="tab" data-tab="renamed">Renamed ({{ files_by_status.renamed|length }})</button>
        {% endif %}
      </div>

      {% for status, items in files_by_status.items() %}
      <div class="tab-panel {% if status == 'added' %}active{% endif %}" id="panel-{{ status }}">
        {% if items %}
        <ul class="file-list">
          {% for f in items %}
          <li class="file-item" data-path="{{ f.path|lower }}">
            <div class="file-path" title="{{ f.path }}">{{ f.path }}</div>
            <div class="file-meta">
              <span class="tag tag-cat">{{ f.category }}</span>
              <span class="tag tag-cat">{{ f.language }}</span>
              {% if f.old_path %}<span>was {{ f.old_path }}</span>{% endif %}
            </div>
            {% if f.has_detail %}
            <details>
              <summary>Show class / method / API changes</summary>
              {% if f.classes_added %}<p><strong>Classes added</strong></p><ul>{% for c in f.classes_added %}<li>{{ c }}</li>{% endfor %}</ul>{% endif %}
              {% if f.classes_removed %}<p><strong>Classes removed</strong></p><ul>{% for c in f.classes_removed %}<li>{{ c }}</li>{% endfor %}</ul>{% endif %}
              {% if f.methods_added %}<p><strong>Methods added</strong></p><ul>{% for m in f.methods_added %}<li>{{ m }}</li>{% endfor %}</ul>{% endif %}
              {% if f.methods_removed %}<p><strong>Methods removed</strong></p><ul>{% for m in f.methods_removed %}<li>{{ m }}</li>{% endfor %}</ul>{% endif %}
              {% if f.methods_modified %}<p><strong>Methods modified</strong></p><ul>{% for m in f.methods_modified %}<li>{{ m }}</li>{% endfor %}</ul>{% endif %}
              {% if f.apis_added %}<p><strong>APIs added</strong></p><ul>{% for a in f.apis_added %}<li>{{ a }}</li>{% endfor %}</ul>{% endif %}
              {% if f.apis_removed %}<p><strong>APIs removed</strong></p><ul>{% for a in f.apis_removed %}<li>{{ a }}</li>{% endfor %}</ul>{% endif %}
            </details>
            {% endif %}
          </li>
          {% endfor %}
        </ul>
        {% else %}
        <p class="empty">No files in this category.</p>
        {% endif %}
      </div>
      {% endfor %}
    </section>

    <section>
      <h2>Methods</h2>
      <div class="two-col">
        <div>
          <div class="branch-label branch-a">Only in {{ branch_a }} ({{ methods_a|length }})</div>
          {% if methods_a %}
          <table class="simple-table">
            <thead><tr><th>Method</th><th>File</th></tr></thead>
            <tbody>
              {% for m in methods_a[:100] %}
              <tr>
                <td><span class="file-path">{{ m.class_name }}.{{ m.signature }}</span></td>
                <td class="file-meta">{{ m.file }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
          {% if methods_a|length > 100 %}<p class="empty">… and {{ methods_a|length - 100 }} more</p>{% endif %}
          {% else %}<p class="empty">None</p>{% endif %}
        </div>
        <div>
          <div class="branch-label branch-b">Only in {{ branch_b }} ({{ methods_b|length }})</div>
          {% if methods_b %}
          <table class="simple-table">
            <thead><tr><th>Method</th><th>File</th></tr></thead>
            <tbody>
              {% for m in methods_b[:100] %}
              <tr>
                <td><span class="file-path">{{ m.class_name }}.{{ m.signature }}</span></td>
                <td class="file-meta">{{ m.file }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
          {% if methods_b|length > 100 %}<p class="empty">… and {{ methods_b|length - 100 }} more</p>{% endif %}
          {% else %}<p class="empty">None</p>{% endif %}
        </div>
      </div>
      {% if methods_modified %}
      <p style="margin-top:1rem"><strong>Modified in both branches:</strong> {{ methods_modified|length }}</p>
      <details>
        <summary>Show modified methods</summary>
        <ul>{% for m in methods_modified[:80] %}<li class="file-path">{{ m }}</li>{% endfor %}</ul>
        {% if methods_modified|length > 80 %}<p class="empty">… and {{ methods_modified|length - 80 }} more</p>{% endif %}
      </details>
      {% endif %}
    </section>

    <section>
      <h2>APIs (AOSP · AAOS · vendor)</h2>
      {% if api_kinds %}
      <table class="simple-table" style="margin-bottom:1.25rem">
        <thead><tr><th>Kind</th><th>Removed from {{ branch_b }}</th><th>Added in {{ branch_b }}</th></tr></thead>
        <tbody>
          {% for k in api_kinds %}
          <tr>
            <td>{{ k.kind }}</td>
            <td>{% if k.removed %}−{{ k.removed }}{% else %}—{% endif %}</td>
            <td>{% if k.added %}+{{ k.added }}{% else %}—{% endif %}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% endif %}

      <div class="two-col">
        <div>
          <div class="branch-label branch-a">Only in {{ branch_a }} ({{ apis_removed|length }})</div>
          {% if apis_removed %}
          <table class="simple-table">
            <thead><tr><th>API</th><th>Kind</th></tr></thead>
            <tbody>
              {% for a in apis_removed[:60] %}
              <tr>
                <td class="file-path">{{ a.name }}</td>
                <td class="file-meta">{{ a.kind }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
          {% if apis_removed|length > 60 %}<p class="empty">… and {{ apis_removed|length - 60 }} more</p>{% endif %}
          {% else %}<p class="empty">None</p>{% endif %}
        </div>
        <div>
          <div class="branch-label branch-b">Only in {{ branch_b }} ({{ apis_added|length }})</div>
          {% if apis_added %}
          <table class="simple-table">
            <thead><tr><th>API</th><th>Kind</th></tr></thead>
            <tbody>
              {% for a in apis_added[:60] %}
              <tr>
                <td class="file-path">{{ a.name }}</td>
                <td class="file-meta">{{ a.kind }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
          {% if apis_added|length > 60 %}<p class="empty">… and {{ apis_added|length - 60 }} more</p>{% endif %}
          {% else %}<p class="empty">None</p>{% endif %}
        </div>
      </div>
      <p class="file-meta" style="margin-top:1rem">{{ apis_in_both_count }} APIs unchanged in both branches.</p>
    </section>

    {% if warnings %}
    <div class="warn-box">
      <strong>{{ warnings|length }} warnings</strong> during analysis (skipped or unparseable files).
      <details>
        <summary>Show warnings</summary>
        <ul>{% for w in warnings %}<li>{{ w }}</li>{% endfor %}</ul>
      </details>
    </div>
    {% endif %}

    <section>
      <h2>Branch sizes</h2>
      <div class="compare-row"><span>Files</span><span>{{ summary.branch_a.total_files }} → {{ summary.branch_b.total_files }}</span></div>
      <div class="compare-row"><span>Classes</span><span>{{ summary.branch_a.class_count }} → {{ summary.branch_b.class_count }}</span></div>
      <div class="compare-row"><span>Methods</span><span>{{ summary.branch_a.method_count }} → {{ summary.branch_b.method_count }}</span></div>
      <div class="compare-row"><span>API references</span><span>{{ summary.branch_a.api_count }} → {{ summary.branch_b.api_count }}</span></div>
      <p class="file-meta" style="margin-top:.75rem">Merge base: <code>{{ merge_base }}</code></p>
    </section>

    <footer>aaos-branch-diff v{{ version }}</footer>
  </div>

  <script>
    document.querySelectorAll('#fileTabs .tab').forEach(btn => {
      btn.addEventListener('click', () => {
        document.querySelectorAll('#fileTabs .tab').forEach(b => b.classList.remove('active'));
        document.querySelectorAll('.tab-panel').forEach(p => p.classList.remove('active'));
        btn.classList.add('active');
        document.getElementById('panel-' + btn.dataset.tab).classList.add('active');
      });
    });
    function filterFiles(q) {
      const query = q.toLowerCase();
      document.querySelectorAll('.file-item').forEach(item => {
        item.style.display = item.dataset.path.includes(query) ? '' : 'none';
      });
    }
  </script>
</body>
</html>
