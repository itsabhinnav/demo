<!DOCTYPE html>
<html lang="en" data-theme="light">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="color-scheme" content="light only">
  <meta name="theme-color" content="#ffffff">
  <title>{{ branch_a }} → {{ branch_b }} · Branch Diff</title>
  <style>
    :root {
      color-scheme: light;
      --bg: #ffffff;
      --bg-subtle: #f6f8fa;
      --card: #ffffff;
      --text: #24292f;
      --muted: #57606a;
      --border: #d8dee4;
      --accent: #0969da;
      --added: #1a7f37;
      --removed: #cf222e;
      --modified: #9a6700;
      --renamed: #8250df;
    }
    html {
      color-scheme: light;
      background: var(--bg-subtle);
    }
    * { box-sizing: border-box; }
    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background: var(--bg-subtle);
      color: var(--text);
      margin: 0;
      line-height: 1.6;
      font-size: 15px;
    }
    .wrap { max-width: 960px; margin: 0 auto; padding: 2rem 1.25rem 3rem; }
    header { margin-bottom: 2rem; }
    h1 { font-size: 1.75rem; font-weight: 600; margin: 0 0 .5rem; }
    .subtitle { color: var(--muted); font-size: .95rem; }
    .subtitle code {
      background: #eaeef2;
      padding: .1rem .35rem;
      border-radius: 4px;
      font-size: .85rem;
    }
    .hero {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.5rem;
      margin-bottom: 2rem;
    }
    .hero p { margin: 0 0 1rem; font-size: 1.05rem; }
    .stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(120px, 1fr));
      gap: .75rem;
    }
    .stat {
      text-align: center;
      padding: .75rem;
      background: var(--bg-subtle);
      border-radius: 8px;
    }
    .stat .n { font-size: 1.5rem; font-weight: 700; display: block; }
    .stat .l { font-size: .75rem; color: var(--muted); text-transform: uppercase; letter-spacing: .03em; }
    .stat.added .n { color: var(--added); }
    .stat.removed .n { color: var(--removed); }
    .stat.modified .n { color: var(--modified); }
    section {
      background: var(--card);
      border: 1px solid var(--border);
      border-radius: 12px;
      padding: 1.25rem 1.5rem;
      margin-bottom: 1.25rem;
    }
    h2 {
      font-size: 1.1rem;
      margin: 0 0 1rem;
      padding-bottom: .5rem;
      border-bottom: 1px solid var(--border);
    }
    .tabs { display: flex; gap: .5rem; flex-wrap: wrap; margin-bottom: 1rem; }
    .tab {
      border: 1px solid var(--border);
      background: #fff;
      padding: .4rem .85rem;
      border-radius: 20px;
      font-size: .85rem;
      cursor: pointer;
      color: var(--text);
    }
    .tab.active { background: var(--accent); color: #fff; border-color: var(--accent); }
    .tab-panel { display: none; }
    .tab-panel.active { display: block; }
    .file-list { list-style: none; margin: 0; padding: 0; }
    .file-item {
      padding: .6rem 0;
      border-bottom: 1px solid var(--border);
    }
    .file-item:last-child { border-bottom: none; }
    .file-path {
      font-family: ui-monospace, Menlo, Consolas, monospace;
      font-size: .82rem;
      word-break: break-all;
    }
    .file-meta { font-size: .8rem; color: var(--muted); margin-top: .2rem; }
    .tag {
      display: inline-block;
      font-size: .7rem;
      font-weight: 600;
      padding: .1rem .45rem;
      border-radius: 4px;
      margin-right: .35rem;
      text-transform: uppercase;
    }
    .tag-added { background: #dafbe1; color: var(--added); }
    .tag-removed { background: #ffebe9; color: var(--removed); }
    .tag-modified { background: #fff8c5; color: var(--modified); }
    .tag-renamed { background: #fbefff; color: var(--renamed); }
    .tag-cat { background: #eaeef2; color: var(--muted); text-transform: none; }
    details { margin-top: .35rem; }
    details summary {
      cursor: pointer;
      font-size: .8rem;
      color: var(--accent);
      user-select: none;
    }
    details ul {
      margin: .35rem 0 0;
      padding-left: 1.25rem;
      font-family: ui-monospace, Menlo, Consolas, monospace;
      font-size: .78rem;
      color: var(--muted);
    }
    ul.compact { margin: .25rem 0; padding-left: 1.25rem; font-size: .78rem; }
    ul.compact.mono { font-family: ui-monospace, Menlo, Consolas, monospace; color: var(--muted); }
    .simple-table { width: 100%; border-collapse: collapse; font-size: .9rem; }
    .simple-table th, .simple-table td {
      padding: .5rem .6rem;
      text-align: left;
      border-bottom: 1px solid var(--border);
    }
    .simple-table th { color: var(--muted); font-weight: 600; font-size: .8rem; background: var(--bg-subtle); }
    .simple-table tr:hover td { background: #f6f8fa; }
    .search {
      width: 100%;
      padding: .55rem .75rem;
      border: 1px solid var(--border);
      border-radius: 8px;
      font-size: .9rem;
      margin-bottom: 1rem;
      background: #fff;
      color: var(--text);
    }
  .search:focus { outline: 2px solid var(--accent); outline-offset: 0; }
    .empty { color: var(--muted); font-style: italic; font-size: .9rem; }
    .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem; }
    @media (max-width: 700px) { .two-col { grid-template-columns: 1fr; } }
    .branch-label { font-weight: 600; margin-bottom: .5rem; font-size: .9rem; }
    .branch-a { color: var(--removed); }
    .branch-b { color: var(--added); }
    .warn-box {
      background: #fff8c5;
      border: 1px solid #d4a72c;
      border-radius: 8px;
      padding: .75rem 1rem;
      font-size: .85rem;
      margin-bottom: 1.25rem;
    }
    .warn-box ul { margin: .5rem 0 0; padding-left: 1.25rem; }
    footer { text-align: center; color: var(--muted); font-size: .8rem; margin-top: 2rem; }
    .compare-row { display: flex; justify-content: space-between; padding: .35rem 0; border-bottom: 1px solid var(--border); font-size: .9rem; }
    .compare-row:last-child { border-bottom: none; }
    .section-note { font-size: .85rem; color: var(--muted); margin: -.5rem 0 1rem; }
    .test-section {
      border: 1px dashed var(--border);
      background: #fafbfc;
      border-radius: 12px;
      padding: .75rem 1.25rem;
      margin-bottom: 1.25rem;
    }
    .test-section summary {
      cursor: pointer;
      font-weight: 600;
      color: var(--muted);
      font-size: .9rem;
      user-select: none;
    }
    .test-section .inner { margin-top: 1rem; }
    .test-section .file-item { opacity: .9; }
  </style>
</head>
<body>
  <div class="wrap">
    <header>
      <h1>Branch Diff Report</h1>
      <p class="subtitle">
        <code>{{ branch_a }}</code> → <code>{{ branch_b }}</code>
        &nbsp;·&nbsp; {{ repo_path }}
        &nbsp;·&nbsp; {{ generated_at }}
      </p>
    </header>

    <div class="hero">
      <p>
        Comparing <strong>{{ branch_a }}</strong> (baseline) to <strong>{{ branch_b }}</strong>.
        This report focuses on <strong>production source code</strong> — test changes are summarized separately at the bottom.
      </p>
      <div class="stats">
        <div class="stat">
          <span class="n">{{ source_focus.files.total_changed }}</span>
          <span class="l">Prod. files</span>
        </div>
        <div class="stat added">
          <span class="n">+{{ source_focus.files.added }}</span>
          <span class="l">Added</span>
        </div>
        <div class="stat removed">
          <span class="n">−{{ source_focus.files.removed }}</span>
          <span class="l">Removed</span>
        </div>
        <div class="stat modified">
          <span class="n">~{{ source_focus.files.modified }}</span>
          <span class="l">Modified</span>
        </div>
        <div class="stat">
          <span class="n">{{ source_focus.methods.only_in_a + source_focus.methods.only_in_b }}</span>
          <span class="l">Method changes</span>
        </div>
        <div class="stat">
          <span class="n">{{ source_focus.apis.only_in_a + source_focus.apis.only_in_b }}</span>
          <span class="l">API changes</span>
        </div>
      </div>
    </div>

    {% if summary.ast_index %}
    <section>
      <h2>AST index (phase 1)</h2>
      <p class="section-note">Both branches were fully parsed with tree-sitter AST before diffing.</p>
      <table class="simple-table">
        <thead>
          <tr><th>Branch</th><th>Source files</th><th>AST parsed</th><th>Fallback</th><th>Failed</th><th>Java</th><th>Kotlin</th></tr>
        </thead>
        <tbody>
          {% for label, key in [(branch_a, 'branch_a'), (branch_b, 'branch_b')] %}
          {% set ast = summary.ast_index[key] %}
          <tr>
            <td><code>{{ label }}</code></td>
            <td>{{ ast.source_files }}</td>
            <td>{{ ast.parsed_ast }}</td>
            <td>{{ ast.parsed_fallback }}</td>
            <td>{{ ast.parse_failed }}</td>
            <td>{{ ast.java_files }}</td>
            <td>{{ ast.kotlin_files }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </section>
    {% endif %}

    {% if category_rows %}
    <section>
      <h2>Changes by type</h2>
      <table class="simple-table">
        <thead>
          <tr><th>Type</th><th>Added</th><th>Removed</th><th>Modified</th></tr>
        </thead>
        <tbody>
          {% for row in category_rows %}
          <tr>
            <td>{{ row.label }}</td>
            <td>{% if row.added %}+{{ row.added }}{% else %}—{% endif %}</td>
            <td>{% if row.removed %}−{{ row.removed }}{% else %}—{% endif %}</td>
            <td>{% if row.modified %}~{{ row.modified }}{% else %}—{% endif %}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </section>
    {% endif %}

    <section>
      <h2>Source files</h2>
      <p class="section-note">Main application code under <code>src/main/</code> plus Gradle and resources.</p>
      <input class="search" type="text" placeholder="Search source file paths…" oninput="filterFiles(this.value, 'source')">
      <div class="tabs" id="sourceFileTabs">
        <button class="tab active" data-tab="added" data-group="source">Added ({{ source_files.added|length }})</button>
        <button class="tab" data-tab="removed" data-group="source">Removed ({{ source_files.removed|length }})</button>
        <button class="tab" data-tab="modified" data-group="source">Modified ({{ source_files.modified|length }})</button>
        {% if source_files.renamed|length %}
        <button class="tab" data-tab="renamed" data-group="source">Renamed ({{ source_files.renamed|length }})</button>
        {% endif %}
      </div>

      {% for status, items in source_files.items() %}
      <div class="tab-panel source-panel {% if status == 'added' %}active{% endif %}" id="source-panel-{{ status }}">
        {% if items %}
        <ul class="file-list">
          {% for f in items %}
          <li class="file-item" data-path="{{ f.path|lower }}" data-group="source">
            <div class="file-path" title="{{ f.path }}">{{ f.path }}</div>
            <div class="file-meta">
              <span class="tag tag-cat">{{ f.category }}</span>
              <span class="tag tag-cat">{{ f.language }}</span>
              {% if f.old_path %}<span>was {{ f.old_path }}</span>{% endif %}
            </div>
            {% if f.has_detail %}
            <details>
              <summary>Show class / method / API changes</summary>
              {% if f.classes_added %}<p><strong>Classes added</strong></p><ul>{% for c in f.classes_added %}<li>{{ c }}</li>{% endfor %}</ul>{% endif %}
              {% if f.classes_removed %}<p><strong>Classes removed</strong></p><ul>{% for c in f.classes_removed %}<li>{{ c }}</li>{% endfor %}</ul>{% endif %}
              {% if f.methods_added %}<p><strong>Methods added</strong></p><ul>{% for m in f.methods_added %}<li>{{ m }}</li>{% endfor %}</ul>{% endif %}
              {% if f.methods_removed %}<p><strong>Methods removed</strong></p><ul>{% for m in f.methods_removed %}<li>{{ m }}</li>{% endfor %}</ul>{% endif %}
              {% if f.methods_modified %}<p><strong>Methods modified</strong></p><ul>{% for m in f.methods_modified %}<li>{{ m }}</li>{% endfor %}</ul>{% endif %}
              {% if f.apis_added %}<p><strong>APIs added</strong></p><ul>{% for a in f.apis_added %}<li>{{ a }}</li>{% endfor %}</ul>{% endif %}
              {% if f.apis_removed %}<p><strong>APIs removed</strong></p><ul>{% for a in f.apis_removed %}<li>{{ a }}</li>{% endfor %}</ul>{% endif %}
            </details>
            {% endif %}
          </li>
          {% endfor %}
        </ul>
        {% else %}
        <p class="empty">No source files in this category.</p>
        {% endif %}
      </div>
      {% endfor %}
    </section>

    <section>
      <h2>Source methods</h2>
      <div class="two-col">
        <div>
          <div class="branch-label branch-a">Only in {{ branch_a }} ({{ methods_a|length }})</div>
          {% if methods_a %}
          <table class="simple-table">
            <thead><tr><th>Method</th><th>File</th></tr></thead>
            <tbody>
              {% for m in methods_a[:100] %}
              <tr>
                <td><span class="file-path">{{ m.class_name }}.{{ m.signature }}</span></td>
                <td class="file-meta">{{ m.file }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
          {% if methods_a|length > 100 %}<p class="empty">… and {{ methods_a|length - 100 }} more</p>{% endif %}
          {% else %}<p class="empty">None</p>{% endif %}
        </div>
        <div>
          <div class="branch-label branch-b">Only in {{ branch_b }} ({{ methods_b|length }})</div>
          {% if methods_b %}
          <table class="simple-table">
            <thead><tr><th>Method</th><th>File</th></tr></thead>
            <tbody>
              {% for m in methods_b[:100] %}
              <tr>
                <td><span class="file-path">{{ m.class_name }}.{{ m.signature }}</span></td>
                <td class="file-meta">{{ m.file }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
          {% if methods_b|length > 100 %}<p class="empty">… and {{ methods_b|length - 100 }} more</p>{% endif %}
          {% else %}<p class="empty">None</p>{% endif %}
        </div>
      </div>
      {% if methods_modified %}
      <p style="margin-top:1rem"><strong>Modified in both branches:</strong> {{ methods_modified|length }}</p>
      <details>
        <summary>Show modified methods</summary>
        <ul>{% for m in methods_modified[:80] %}<li class="file-path">{{ m }}</li>{% endfor %}</ul>
        {% if methods_modified|length > 80 %}<p class="empty">… and {{ methods_modified|length - 80 }} more</p>{% endif %}
      </details>
      {% endif %}
    </section>

    <section>
      <h2>Source APIs</h2>
      <p class="section-note">AOSP, AAOS, and vendor APIs used in production code.</p>
      {% if api_kinds %}
      <table class="simple-table" style="margin-bottom:1.25rem">
        <thead><tr><th>Kind</th><th>Removed from {{ branch_b }}</th><th>Added in {{ branch_b }}</th></tr></thead>
        <tbody>
          {% for k in api_kinds %}
          <tr>
            <td>{{ k.kind }}</td>
            <td>{% if k.removed %}−{{ k.removed }}{% else %}—{% endif %}</td>
            <td>{% if k.added %}+{{ k.added }}{% else %}—{% endif %}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
      {% endif %}

      <div class="two-col">
        <div>
          <div class="branch-label branch-a">Only in {{ branch_a }} ({{ apis_removed|length }})</div>
          {% if apis_removed %}
          <table class="simple-table">
            <thead><tr><th>API</th><th>Kind</th></tr></thead>
            <tbody>
              {% for a in apis_removed[:60] %}
              <tr>
                <td class="file-path">{{ a.name }}</td>
                <td class="file-meta">{{ a.kind }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
          {% if apis_removed|length > 60 %}<p class="empty">… and {{ apis_removed|length - 60 }} more</p>{% endif %}
          {% else %}<p class="empty">None</p>{% endif %}
        </div>
        <div>
          <div class="branch-label branch-b">Only in {{ branch_b }} ({{ apis_added|length }})</div>
          {% if apis_added %}
          <table class="simple-table">
            <thead><tr><th>API</th><th>Kind</th></tr></thead>
            <tbody>
              {% for a in apis_added[:60] %}
              <tr>
                <td class="file-path">{{ a.name }}</td>
                <td class="file-meta">{{ a.kind }}</td>
              </tr>
              {% endfor %}
            </tbody>
          </table>
          {% if apis_added|length > 60 %}<p class="empty">… and {{ apis_added|length - 60 }} more</p>{% endif %}
          {% else %}<p class="empty">None</p>{% endif %}
        </div>
      </div>
      <p class="file-meta" style="margin-top:1rem">{{ apis_in_both_count }} APIs unchanged in both branches (all code).</p>
    </section>

    {% if has_test_data %}
    <details class="test-section">
      <summary>Test code changes ({{ test_file_counts.total_changed }} files · {{ test_method_counts.test_only_in_a + test_method_counts.test_only_in_b }} methods · {{ test_api_counts.test_only_in_a + test_api_counts.test_only_in_b }} APIs)</summary>
      <div class="inner">
        <p class="section-note">Changes under <code>src/test/</code>, <code>src/androidTest/</code>, and test classes. Lower priority — expand only if needed.</p>

        <h2 style="border:none;padding:0;margin:1rem 0 .5rem;font-size:1rem;">Test files</h2>
        <input class="search" type="text" placeholder="Search test file paths…" oninput="filterFiles(this.value, 'test')">
        <div class="tabs" id="testFileTabs">
          <button class="tab active" data-tab="added" data-group="test">Added ({{ test_files.added|length }})</button>
          <button class="tab" data-tab="removed" data-group="test">Removed ({{ test_files.removed|length }})</button>
          <button class="tab" data-tab="modified" data-group="test">Modified ({{ test_files.modified|length }})</button>
        </div>
        {% for status, items in test_files.items() %}
        <div class="tab-panel test-panel {% if status == 'added' %}active{% endif %}" id="test-panel-{{ status }}">
          {% if items %}
          <ul class="file-list">
            {% for f in items %}
            <li class="file-item" data-path="{{ f.path|lower }}" data-group="test">
              <div class="file-path">{{ f.path }}</div>
            </li>
            {% endfor %}
          </ul>
          {% else %}<p class="empty">None</p>{% endif %}
        </div>
        {% endfor %}

        {% if methods_a_test or methods_b_test %}
        <h2 style="border:none;padding:0;margin:1.25rem 0 .5rem;font-size:1rem;">Test methods</h2>
        <div class="two-col">
          <div>
            <div class="branch-label branch-a">Only in {{ branch_a }} ({{ methods_a_test|length }})</div>
            {% if methods_a_test %}<ul class="compact mono">{% for m in methods_a_test[:40] %}<li>{{ m.class_name }}.{{ m.signature }}</li>{% endfor %}</ul>{% else %}<p class="empty">None</p>{% endif %}
          </div>
          <div>
            <div class="branch-label branch-b">Only in {{ branch_b }} ({{ methods_b_test|length }})</div>
            {% if methods_b_test %}<ul class="compact mono">{% for m in methods_b_test[:40] %}<li>{{ m.class_name }}.{{ m.signature }}</li>{% endfor %}</ul>{% else %}<p class="empty">None</p>{% endif %}
          </div>
        </div>
        {% endif %}

        {% if apis_removed_test or apis_added_test %}
        <h2 style="border:none;padding:0;margin:1.25rem 0 .5rem;font-size:1rem;">Test APIs</h2>
        <div class="two-col">
          <div>{% if apis_removed_test %}<ul class="compact mono">{% for a in apis_removed_test[:30] %}<li>{{ a.name }}</li>{% endfor %}</ul>{% else %}<p class="empty">None removed</p>{% endif %}</div>
          <div>{% if apis_added_test %}<ul class="compact mono">{% for a in apis_added_test[:30] %}<li>{{ a.name }}</li>{% endfor %}</ul>{% else %}<p class="empty">None added</p>{% endif %}</div>
        </div>
        {% endif %}
      </div>
    </details>
    {% endif %}

    {% if warnings %}
    <div class="warn-box">
      <strong>{{ warnings|length }} warnings</strong> during analysis (skipped or unparseable files).
      <details>
        <summary>Show warnings</summary>
        <ul>{% for w in warnings %}<li>{{ w }}</li>{% endfor %}</ul>
      </details>
    </div>
    {% endif %}

    <section>
      <h2>Branch sizes</h2>
      <div class="compare-row"><span>Production source files</span><span>{{ source_focus.branch_sizes.source_files_a }} → {{ source_focus.branch_sizes.source_files_b }}</span></div>
      <div class="compare-row"><span>Production methods</span><span>{{ source_focus.branch_sizes.source_methods_a }} → {{ source_focus.branch_sizes.source_methods_b }}</span></div>
      <div class="compare-row"><span>Test files</span><span>{{ source_focus.branch_sizes.test_files_a }} → {{ source_focus.branch_sizes.test_files_b }}</span></div>
      <p class="file-meta" style="margin-top:.75rem">Merge base: <code>{{ merge_base }}</code> · Total files changed (all): {{ summary.files.total_changed }}</p>
    </section>

    <footer>aaos-branch-diff v{{ version }}</footer>
  </div>

  <script>
    function setupTabs(containerId, panelPrefix) {
      const container = document.getElementById(containerId);
      if (!container) return;
      container.querySelectorAll('.tab').forEach(btn => {
        btn.addEventListener('click', () => {
          const group = btn.dataset.group || 'source';
          container.querySelectorAll('.tab').forEach(b => b.classList.remove('active'));
          document.querySelectorAll('.' + group + '-panel').forEach(p => p.classList.remove('active'));
          btn.classList.add('active');
          const panel = document.getElementById(panelPrefix + '-' + btn.dataset.tab);
          if (panel) panel.classList.add('active');
        });
      });
    }
    setupTabs('sourceFileTabs', 'source-panel');
    setupTabs('testFileTabs', 'test-panel');

    function filterFiles(q, group) {
      const query = q.toLowerCase();
      document.querySelectorAll('.file-item[data-group="' + group + '"]').forEach(item => {
        item.style.display = item.dataset.path.includes(query) ? '' : 'none';
      });
    }
  </script>
</body>
</html>
